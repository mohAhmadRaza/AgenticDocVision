# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual ".env" file to GitHub — only this .example file.

# Groq API key — used by Agent 4 (LLM OCR correction) via langchain-groq
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ngrok auth token — used to expose the local FastAPI frontend publicly
# Get one free at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
